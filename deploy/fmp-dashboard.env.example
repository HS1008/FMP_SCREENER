# Host env for fmp-dashboard. Copy to /etc/fmp/fmp-dashboard.env (0600).
# Never commit a filled copy. Never put writer DB credentials here.

# Dedicated Streamlit identity. Not mi_readonly (that role lacks strategies/backtests).
DASHBOARD_READONLY_URL=postgresql://dashboard_readonly:CHANGE_ME@127.0.0.1:5432/fmp

# Temporary host escape only. Strategy Monitor fails closed when the URL is unset
# unless this is explicitly enabled. Remove after dashboard_readonly is provisioned.
# DASHBOARD_ALLOW_WRITER_FALLBACK=1

# Optional: Market Intelligence pages (mi_readonly). Not a writer.
# DATABASE_READONLY_URL=postgresql://mi_readonly:CHANGE_ME@127.0.0.1:5432/fmp

# Provider fetches stay denied unless an operator explicitly opts in.
STREAMLIT_ALLOW_PROVIDER_FETCH=0
