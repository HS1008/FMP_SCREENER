# Example reverse proxy for the read-only AI gateway.
# PostgreSQL stays on localhost / private network. This file is a template;
# replace server_name and certificate paths. Do not expose port 5432.

# upstream binds the existing systemd unit (127.0.0.1:8765)
upstream fmp_ai_gateway {
    server 127.0.0.1:8765;
}

server {
    listen 443 ssl http2;
    server_name mcp.example.com api.example.com;

    ssl_certificate     /etc/letsencrypt/live/mcp.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/mcp.example.com/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;

    client_max_body_size 64k;

    location / {
        proxy_pass http://fmp_ai_gateway;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
        proxy_read_timeout 30s;
    }
}

server {
    listen 80;
    server_name mcp.example.com api.example.com;
    return 301 https://$host$request_uri;
}
