# Market Intelligence environment (copy to /etc/fmp/market_intelligence.env, chmod 0600, owner root).
# Loaded by fmp-mi-refresh.service via EnvironmentFile. The AI Context API uses
# /etc/fmp/ai_context_api.env (read-only DB + API token only). Never commit a populated copy.

# --- writer identity (refresh job only) -------------------------------------------------------
# Either a dedicated URL or the existing DB_* variables already used by the dashboard.
# MARKET_INTELLIGENCE_DATABASE_URL=postgresql://fmp_writer:CHANGE_ME@127.0.0.1:5432/fmp
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=fmp
# DB_USER=fmp_writer
# DB_PASSWORD=CHANGE_ME

# --- read-only identity (Streamlit MI pages + AI context API) ---------------------------------
# Provision the role first (password is prompted, or read from a 0600 file; never typed into argv):
#   psql "$ADMIN_DATABASE_URL" -f db/roles/market_intelligence_readonly.sql
#   psql "$ADMIN_DATABASE_URL" -v ro_password="$(cat /etc/fmp/mi_readonly.pw)" -f db/roles/market_intelligence_readonly.sql
# DATABASE_READONLY_URL=postgresql://mi_readonly:CHANGE_ME@127.0.0.1:5432/fmp
# Strategy Monitor / full dashboard identity (do not reuse mi_readonly):
#   psql "$ADMIN_DATABASE_URL" -v ro_password="$(cat /root/FMP_SCREENER/.secrets/dashboard_readonly.pw)" -f db/roles/dashboard_readonly.sql
# DASHBOARD_READONLY_URL=postgresql://dashboard_readonly:CHANGE_ME@127.0.0.1:5432/fmp
# Optional CREATEROLE identity for first-time role creation (never the dashboard writer):
# MI_ADMIN_DATABASE_URL=postgresql://admin:CHANGE_ME@127.0.0.1:5432/fmp

# --- providers -----------------------------------------------------------------------------------
# FRED_API_KEY=CHANGE_ME                       # https://fred.stlouisfed.org/docs/api/api_key.html
# MARKET_INTELLIGENCE_PRECOMPUTED_ROOT=/root/FMP_SCREENER/outputs/precomputed   # legacy bridge; defaults to config.OUTPUT_DIR/precomputed
# MI_FMP_FREE=
# MI_ALLOW_LEGACY_FMP=0
# MI_EQUITY_PROVIDER=                           # unset = UNAVAILABLE; ibkr = Windows collector ADJUSTED_LAST (do not set until soak)
# IBKR_ALLOW_TWS_SOCKET=0                      # DigitalOcean must stay 0; only the Windows collector opens TWS
# MI_TREASURY_ENABLED=

# --- AI context API + read-only gateway (REST /api/v1, MCP /mcp) --------------------------------
# AI_CONTEXT_API_TOKEN=CHANGE_ME               # long random bearer token; API fails closed (503) when unset
# AI_CONTEXT_API_HOST=127.0.0.1
# AI_CONTEXT_API_PORT=8765
# AI_GATEWAY_PUBLIC_BASE_URL=                  # public HTTPS origin for OAuth metadata once nginx fronts /mcp
# AI_GATEWAY_EXPORT_MODE=external              # external (default) redacts INTERNAL_ONLY/RESTRICTED; owner = proven local sessions only
# AI_GATEWAY_REMOTE_VALUE_SOURCES=             # source_ids with a human-confirmed remote export right (empty = none)
# AI_GATEWAY_TRUST_PROXY=1                     # X-Forwarded-For marks a request remote (keep on behind nginx)
# AI_GATEWAY_RATE_LIMIT_PER_MINUTE=60
# AI_GATEWAY_CORS_ORIGINS=                     # empty = CORS disabled; "*" is never honoured
# AI_GATEWAY_OAUTH_ENABLED=1

# --- external adapters (all off by default; the scheduled refresh never calls them) ------------
# SEC_USER_AGENT="FMP Research ops@example.com"  # SEC fair-access policy requires org + contact
# MI_EDGAR_ENABLED=0
# MI_FINRA_ENABLED=0
# MI_TRACE_ENABLED=0
# FINRA_CLIENT_ID=
# FINRA_CLIENT_SECRET=
# FINRA_API_CLIENT_ID=
# FINRA_API_CLIENT_SECRET=
# MI_IBKR_MARKET_DATA_ENABLED=0                 # server fetch stays off; Windows collector is a separate process
