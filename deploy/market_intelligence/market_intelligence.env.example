# Market Intelligence environment (copy to /etc/fmp/market_intelligence.env, chmod 0600, owner root).
# Loaded by fmp-mi-refresh.service and fmp-ai-context-api.service via EnvironmentFile.
# Never commit a populated copy. Values below are placeholders, not credentials.

# --- writer identity (refresh job only) -------------------------------------------------------
# Either a dedicated URL or the existing DB_* variables already used by the dashboard.
# MARKET_INTELLIGENCE_DATABASE_URL=postgresql://fmp_writer:CHANGE_ME@127.0.0.1:5432/fmp
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=fmp
# DB_USER=fmp_writer
# DB_PASSWORD=CHANGE_ME

# --- read-only identity (Streamlit MI pages + AI context API) ---------------------------------
# Provision the role first (password is prompted, or read from a 0600 file; never typed into argv):
#   psql "$ADMIN_DATABASE_URL" -f db/roles/market_intelligence_readonly.sql
#   psql "$ADMIN_DATABASE_URL" -v ro_password="$(cat /etc/fmp/mi_readonly.pw)" -f db/roles/market_intelligence_readonly.sql
# DATABASE_READONLY_URL=postgresql://mi_readonly:CHANGE_ME@127.0.0.1:5432/fmp

# --- providers -----------------------------------------------------------------------------------
# FRED_API_KEY=CHANGE_ME                       # https://fred.stlouisfed.org/docs/api/api_key.html
# MARKET_INTELLIGENCE_PRECOMPUTED_ROOT=/root/FMP_SCREENER/outputs/precomputed   # legacy bridge; defaults to config.OUTPUT_DIR/precomputed

# --- AI context API ------------------------------------------------------------------------------
# AI_CONTEXT_API_TOKEN=CHANGE_ME               # long random bearer token; API fails closed (503) when unset
# AI_CONTEXT_API_HOST=127.0.0.1
# AI_CONTEXT_API_PORT=8765

# --- external adapters (all off by default; the scheduled refresh never calls them) ------------
# SEC_USER_AGENT="FMP Research ops@example.com"  # SEC fair-access policy requires org + contact
# MI_EDGAR_ENABLED=0
# MI_TRACE_ENABLED=0
# FINRA_API_CLIENT_ID=
# FINRA_API_CLIENT_SECRET=
# MI_IBKR_MARKET_DATA_ENABLED=0                 # server fetch stays off; Windows collector is a separate process
