# Read-only AI context API + gateway environment (copy to /etc/fmp/ai_context_api.env, chmod 0600).
# This file must NOT contain provider keys, writer DB credentials, or IBKR ingest tokens.
# Never commit a populated copy.

# DATABASE_READONLY_URL=postgresql://mi_readonly:CHANGE_ME@127.0.0.1:5432/fmp
# AI_CONTEXT_API_TOKEN=CHANGE_ME
# AI_CONTEXT_API_HOST=127.0.0.1
# AI_CONTEXT_API_PORT=8765

# --- read-only gateway (REST /api/v1, MCP /mcp) ---------------------------------------------
# Public HTTPS origin used in OAuth metadata and token audience once nginx fronts the gateway,
# e.g. https://mcp.example.com. Leave empty while the gateway is loopback-only.
# AI_GATEWAY_PUBLIC_BASE_URL=
# Export policy preference. "external" (default) redacts INTERNAL_ONLY / RESTRICTED values for
# every session. "owner" permits stored dashboard values ONLY for a proven local session
# (stdio MCP or a loopback client without proxy headers); remote clients always get external.
# AI_GATEWAY_EXPORT_MODE=external
# Comma-separated source_ids whose INTERNAL_ONLY / RESTRICTED values a human has confirmed may
# be transmitted to remote AI clients under the provider's terms. Empty = none.
# AI_GATEWAY_REMOTE_VALUE_SOURCES=
# Treat X-Forwarded-For / X-Real-IP as proof of a remote client (default 1; keep on behind nginx).
# AI_GATEWAY_TRUST_PROXY=1
# AI_GATEWAY_RATE_LIMIT_PER_MINUTE=60
# AI_GATEWAY_CORS_ORIGINS=
# AI_GATEWAY_OAUTH_ENABLED=1
